// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum TaskPriority {
  LOW
  MEDIUM
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  password  String   @map("password_hash")
  createdAt DateTime @default(now()) @map("created_at")

  refreshTokens RefreshToken[]
  memberships   WorkspaceMember[]
  documents     Document[]
  createdTasks  Task[]            @relation("TaskCreator")
  assignedTasks Task[]            @relation("TaskAssignee")
  reviewTasks   Task[]            @relation("TaskReviewer")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  members   WorkspaceMember[]
  documents Document[]
  tasks     Task[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String @map("workspace_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  role        Role   @default(EDITOR)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Document {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  title       String   @default("Untitled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User              @relation(fields: [createdById], references: [id])
  parent    Document?         @relation("DocumentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Document[]        @relation("DocumentTree")
  snapshot  DocumentSnapshot?
  tasks     Task[]

  @@index([workspaceId])
  @@index([parentId])
  @@map("documents")
}

model DocumentSnapshot {
  documentId String   @id @map("document_id") @db.Uuid
  state      Bytes
  updatedAt  DateTime @default(now()) @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_snapshots")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  documentId  String?      @map("document_id") @db.Uuid
  createdById String       @map("created_by_id") @db.Uuid
  assigneeId  String?      @map("assignee_id") @db.Uuid
  reviewerId  String?      @map("reviewer_id") @db.Uuid
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdBy User      @relation("TaskCreator", fields: [createdById], references: [id])
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewer  User?     @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([assigneeId])
  @@map("tasks")
}
