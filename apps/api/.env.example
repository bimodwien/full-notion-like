DATABASE_URL=postgresql://<user>:<password>@localhost:5432/notion_like
PORT=3000
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=30m
WEB_ORIGIN=http://localhost:3000
# Production only: the parent domain the web app and API share, e.g. .example.com
COOKIE_DOMAIN=
# Leave SMTP_HOST empty in dev: mail is printed to the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NoBimotion <no-reply@example.com>"
